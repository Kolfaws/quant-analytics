# =============================================================================
# .gitignore — quant-analytics
#
# 原则：优先使用项目目录下的 .gitignore；根目录不放全局忽略规则。
# 结构：敏感信息 → 数据/数据库 → Python → 虚拟环境 → 缓存 → 日志 → 编辑器
# =============================================================================

# ------------------------------------------------------------------ 1. 敏感信息
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
*.p12
secrets.yaml
secrets.yml

# ------------------------------------------------------------------ 2. 数据与数据库
# 数据底座在项目外，由环境变量指定；本地临时导出也不进版本库
data/**
!data/
!data/**/.gitkeep
*.duckdb
*.duckdb.wal
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.parquet
*.feather
*.arrow
*.csv
*.tsv
*.xlsx
*.xls
*.h5
*.hdf5
*.pkl
*.pickle

# ------------------------------------------------------------------ 3. Python 构建产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------------ 4. 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# ------------------------------------------------------------------ 5. 测试 / 类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/

# ------------------------------------------------------------------ 6. 日志
logs/**
!logs/.gitkeep
*.log

# ------------------------------------------------------------------ 7. 编辑器 / 系统
.DS_Store
._*
.Thumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------ 8. 临时文件
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*
